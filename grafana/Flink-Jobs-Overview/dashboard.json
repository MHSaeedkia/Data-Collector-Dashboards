        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "showHeader": true,
        "sortBy": [
          {
            "desc": true,
            "displayName": "Backpressure %"
          }
        ]
      },
      "pluginVersion": "11.4.0",
      "targets": [
        {
          "expr": "sum by (job_name) (flink_taskmanager_job_task_numRecordsInPerSecond)",
          "format": "table",
          "instant": true,
          "refId": "A"
        },
        {
          "expr": "sum by (job_name) (flink_taskmanager_job_task_numRecordsOutPerSecond)",
          "format": "table",
          "instant": true,
          "refId": "B"
        },
        {
          "expr": "avg by (job_name) (flink_taskmanager_job_task_busyTimeMsPerSecond) / 10",
          "format": "table",
          "instant": true,
          "refId": "C"
        },
        {
          "expr": "avg by (job_name) (flink_taskmanager_job_task_idleTimeMsPerSecond) / 10",
          "format": "table",
          "instant": true,
          "refId": "D"
        },
        {
          "expr": "avg by (job_name) (flink_taskmanager_job_task_backPressuredTimeMsPerSecond) / 10",
          "format": "table",
          "instant": true,
          "refId": "E"
        },
        {
          "expr": "clamp_max((avg by (job_name) (flink_taskmanager_job_task_busyTimeMsPerSecond) / 10) + (avg by (job_name) (flink_taskmanager_job_task_backPressuredTimeMsPerSecond) / 10), 100)",
          "format": "table",
          "instant": true,
          "refId": "F"
        }
      ],
      "title": "Job Status Overview",
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "job_name",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "Value #A": 1,
              "Value #B": 2,
              "Value #C": 3,
              "Value #D": 4,
              "Value #E": 5,
              "Value #F": 6,
              "job_name": 0
            },
            "renameByName": {
              "Value #A": "Records In/sec",
              "Value #B": "Records Out/sec",
              "Value #C": "Busy %",
              "Value #D": "Idle %",
              "Value #E": "Backpressure %",
              "Value #F": "Health Score",
              "job_name": "Job"
            }
          }
        }
      ],
      "type": "table"
    },
