      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_POSTGRES}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  stale_since                     AS \"Went stale at\",\n  recovered_at                    AS \"Recovered at\",\n  COALESCE(duration_seconds, EXTRACT(EPOCH FROM (now() - stale_since)))::float8\n                                  AS \"Duration\",\n  threshold_seconds               AS \"Threshold\",\n  CASE WHEN recovered_at IS NULL THEN 'ongoing' ELSE 'recovered' END\n                                  AS \"Status\"\nFROM topic_staleness_episodes\nWHERE topic = '$topic'\n  -- Overlap, not containment: an episode that started before the dashboard\n  -- window but is still running (or ended inside it) is the one you most want\n  -- to see. $__timeFilter(stale_since) would hide exactly those.\n  AND stale_since <= $__timeTo()\n  AND COALESCE(recovered_at, now()) >= $__timeFrom()\nORDER BY stale_since DESC\nLIMIT 500",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
      "title": "$topic",
