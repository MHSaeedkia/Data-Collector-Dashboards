# --- server ---
LISTEN_ADDR=:8080
CONFIG_PATH=./config/config.yaml

# --- log ---
LOG_LEVEL=info

# --- telegram ---
TELEGRAM_BOT_TOKEN=123456:ABC-your-telegram-bot-token
TELEGRAM_CHAT_ID=-1001234567890
# If the server has no direct access to Telegram, put the HTTP proxy here
# Example: http://127.0.0.1:3128  or  http://user:pass@host:port
TELEGRAM_PROXY_URL=http://<proxy-host>:<proxy-port>

# --- bale ---
BALE_BOT_TOKEN=123456:your-bale-bot-token
BALE_CHAT_ID=123456789
BALE_API_BASE=https://tapi.bale.ai
